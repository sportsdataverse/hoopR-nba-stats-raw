# History files
.Rhistory
.Rapp.history

# Session Data files
.RData

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# Atomic-write leftovers from the sdv-py raw JSON store (tmp + rename);
# a torn run may strand these — they are never valid payloads.
*.json.tmp

# Local sweep logs (scripts/scrape_raw_json.py runs)
logs/

# Tooling byproducts
__pycache__/
.omc/

# --- SDV repo template ---------------------------------------------------
# Top-level run artifacts. logs/ is already ignored wholesale above, so a
# `!logs/*.log` negation here would be dead -- git does not re-include files
# inside an ignored directory.
/*.out
/*.log

# Editable-install metadata produced by `uv sync` against the root pyproject.
*.egg-info/
**/*.egg-info/

# Tool scratch directories (bare and nested).
.omc/
**/.omc/
.Rproj.user/
**/.Rproj.user/
.ruff_cache/
**/.ruff_cache/
.understand-anything/
**/.understand-anything/
.superpowers/
**/.superpowers/
.pytest_cache/
**/.pytest_cache/
.venv/
**/.venv/

# Season bundles (nba_stats_json_{END}.tar.gz) are RELEASE-only since
# 2026-09-30: the clone-free raw-store backend is the `nba-stats-raw-json`
# release (scripts that hydrate a store download from it). Git tracked them
# until the END re-key pushed 7 past GitHub's 100 MiB per-file limit.
.bundles/
