# History files
.Rhistory
.Rapp.history

# Session Data files
.RData

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# Atomic-write leftovers from the sdv-py raw JSON store (tmp + rename);
# a torn run may strand these — they are never valid payloads.
*.json.tmp

# Local sweep logs (scripts/scrape_raw_json.py runs)
logs/

# Tooling byproducts
__pycache__/
.omc/

# --- SDV repo template ---------------------------------------------------
# Top-level run artifacts only; logs/*.log stays tracked (the scrapers commit
# one per season and overwrite it each run).
/*.out
/*.log
!logs/*.log

# Editable-install metadata produced by `uv sync` against the root pyproject.
*.egg-info/
**/*.egg-info/

# Tool scratch directories (bare and nested).
.omc/
**/.omc/
.Rproj.user/
**/.Rproj.user/
.ruff_cache/
**/.ruff_cache/
.understand-anything/
**/.understand-anything/
.superpowers/
**/.superpowers/
.pytest_cache/
**/.pytest_cache/
.venv/
**/.venv/

# NOTE: .bundles/ is NOT ignored. The 31 nba_stats_json_YYYY.tar.gz season
# bundles are tracked deliberately -- they are the clone-free raw-store backend
# that lets consumers fetch a season without cloning ~490k files.
